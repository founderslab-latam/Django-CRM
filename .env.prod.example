# ─────────────────────────────────────────────────────────────────────────────
# BottleCRM production env. Copy to .env.prod (gitignored) on the VPS and fill
# every CHANGE_ME. Loaded into every container via `env_file: .env.prod`.
#
# NOTE: docker compose does NOT substitute this file into docker-compose.prod.yml
# — the Traefik Host() rules there are hard-coded. Only container processes read
# these values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host data directory (bind mounts). Must be unique to this stack so it never
#    collides with the other project's /opt data dir. Override before running:
#      export DATA_DIR=/opt/crm-founderslab-data
#    (default is that same path; set it in the shell if you want another.)

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME            # python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=False
# NOT "prod": ENV_TYPE=prod makes S3 + SES + Sentry env vars mandatory (KeyError
# at startup otherwise) and pins the session cookie to .bottlecrm.io. "dev" with
# DEBUG=False + a real SECRET_KEY + TLS at Traefik is the correct self-host mode.
ENV_TYPE=dev
ALLOWED_HOSTS=api-crm.founderslab.dev,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://crm.founderslab.dev,https://api-crm.founderslab.dev
CORS_ALLOWED_ORIGINS=https://crm.founderslab.dev
CORS_ALLOW_ALL=False
FRONTEND_URL=https://crm.founderslab.dev
DOMAIN_NAME=https://crm.founderslab.dev
# Traefik terminates TLS and sets X-Forwarded-Proto; this lets Django trust it
# so request.is_secure() is true and the HSTS headers actually emit.
TRUST_PROXY_SSL_HEADER=True

# ── gunicorn (read by docker/backend/entrypoint.prod.sh) ─────────────────────
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# POSTGRES_* configure the container's own superuser + database (first boot).
# DB* are what Django connects with. DBUSER is the non-superuser role the init
# script creates — RLS tenant isolation depends on the app NOT being superuser.
POSTGRES_DB=crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DBNAME=crm_db
DBUSER=crm_user
DBPASSWORD=CHANGE_ME_STRONG_TOO
DBHOST=db
DBPORT=5432

# ── Redis / Celery (internal network only) ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Throttle counters (e.g. the public web-form endpoint) live here rather than
# in per-process memory.
CACHE_URL=redis://redis:6379/1

# ── First admin — created/updated on every boot. Your initial login. ─────────
ADMIN_EMAIL=chenrquez@gmail.com
ADMIN_PASSWORD=CHANGE_ME_THEN_ROTATE
DEFAULT_FROM_EMAIL=no-reply@founderslab.dev

# ── Email ───────────────────────────────────────────────────────────────────
# As shipped (console backend) magic-link / invite / invoice-portal / CSAT
# mails are printed to `docker compose -f docker-compose.prod.yml logs
# celery-worker`, not sent. For real delivery, comment the line below, uncomment
# the SMTP block, and fill it in. settings.py reads the SMTP vars only when
# EMAIL_BACKEND is the smtp backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- SMTP (uncomment the whole block; example filled for a HostArmada/cPanel
#     mailbox — for Google Workspace use smtp.gmail.com:587 + an App Password) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.YOURDOMAIN.tld        # cPanel > Email Accounts > Connect Devices shows it
# EMAIL_PORT=587                        # 587 = STARTTLS (below). 465 = SSL: flip the two flags.
# EMAIL_HOST_USER=no-reply@YOURDOMAIN.tld   # a real mailbox; must equal the From address
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL above must be that same mailbox, and YOURDOMAIN.tld needs
# SPF + DKIM pointing at the mail host or Gmail/Outlook will spam-file or reject.

# ── Google OAuth — "Continue with Google" on the login page (optional; blank
#    = button hidden, sign-in still works via magic link). Identity only
#    (openid/email/profile), not used for anything else.
#    Register an OAuth 2.0 "Web application" client in Google Cloud Console with:
#      Authorized redirect URI:  https://crm.founderslab.dev/login
#      Authorized JS origin:     https://crm.founderslab.dev
#    CLIENT_ID is read by both containers; SECRET only by the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_DOMAIN=https://crm.founderslab.dev

# ── Frontend (SvelteKit / adapter-node) ────────────────────────────────────
# The Django origin the browser AND the SSR server call, no trailing /api.
PUBLIC_DJANGO_API_URL=https://api-crm.founderslab.dev
# adapter-node rejects every form POST whose Origin != ORIGIN. Must be the URL
# users actually type.
ORIGIN=https://crm.founderslab.dev
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
PORT=3000
