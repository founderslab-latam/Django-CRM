# ─────────────────────────────────────────────────────────────────────────────
# BottleCRM production env. Copy to .env.prod (gitignored) on the VPS and fill
# every CHANGE_ME. Loaded into every container via `env_file: .env.prod`.
#
# NOTE: docker compose does NOT substitute this file into docker-compose.prod.yml
# — the Traefik Host() rules there are hard-coded. Only container processes read
# these values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host data directory (bind mounts: DB, media, static). Default
#    /opt/crm-founderslab-data — a sibling of the repo checkout, NEVER inside it,
#    so a `git clean -fdx` can't take the database with it. Override only with
#    another ABSOLUTE path OUTSIDE the checkout (e.g. a mounted data disk):
#      export DATA_DIR=/mnt/data/crm      # before docker compose / deploy.sh
#    deploy.sh refuses a relative path or one under the repo.

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME            # python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=False
# NOT "prod": ENV_TYPE=prod makes S3 + SES + Sentry env vars mandatory (KeyError
# at startup otherwise) and pins the session cookie to .bottlecrm.io. "dev" with
# DEBUG=False + a real SECRET_KEY + TLS at Traefik is the correct self-host mode.
ENV_TYPE=dev
ALLOWED_HOSTS=api-crm.founderslab.cloud,backend,localhost,127.0.0.1
# Per-tenant subdomain routing derives from TENANT_BASE_DOMAIN (further down):
# settings.py appends `.<base>` to ALLOWED_HOSTS, `https://*.<base>` to
# CSRF_TRUSTED_ORIGINS, and a `^https://[a-z0-9-]+\.<base>$` CORS regex. Set
# CORS_ALLOWED_ORIGIN_REGEXES here only to override that default.
CSRF_TRUSTED_ORIGINS=https://crm.founderslab.cloud,https://api-crm.founderslab.cloud
CORS_ALLOWED_ORIGINS=https://crm.founderslab.cloud
CORS_ALLOW_ALL=False
FRONTEND_URL=https://crm.founderslab.cloud
DOMAIN_NAME=https://crm.founderslab.cloud
# Traefik terminates TLS and sets X-Forwarded-Proto; this lets Django trust it
# so request.is_secure() is true and the HSTS headers actually emit.
TRUST_PROXY_SSL_HEADER=True

# Public, credential-free host serving the org-logo media subtree. Used to
# build an absolute logo URL that an email client or a headless PDF renderer
# can fetch. Points at the `media` nginx sidecar (see docker-compose.prod.yml);
# add a DNS A record for this host to the VPS. Empty = emails fall back to the
# org's name as text. NEVER a host that serves all of MEDIA_ROOT.
PUBLIC_MEDIA_URL=https://media-crm.founderslab.cloud

# ── gunicorn (read by docker/backend/entrypoint.prod.sh) ─────────────────────
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# POSTGRES_* configure the container's own superuser + database (first boot).
# DB* are what Django connects with. DBUSER is the non-superuser role the init
# script creates — RLS tenant isolation depends on the app NOT being superuser.
POSTGRES_DB=crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DBNAME=crm_db
DBUSER=crm_user
DBPASSWORD=CHANGE_ME_STRONG_TOO
DBHOST=db
DBPORT=5432

# ── Redis / Celery (internal network only) ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Throttle counters (e.g. the public web-form endpoint) live here rather than
# in per-process memory.
CACHE_URL=redis://redis:6379/1

# ── First admin — created/updated on every boot. Your initial login. ─────────
ADMIN_EMAIL=chenrquez@gmail.com
ADMIN_PASSWORD=CHANGE_ME_THEN_ROTATE
DEFAULT_FROM_EMAIL=no-reply@founderslab.cloud

# ── Email ───────────────────────────────────────────────────────────────────
# As shipped (console backend) magic-link / invite / invoice-portal / CSAT
# mails are printed to `docker compose -f docker-compose.prod.yml logs
# celery-worker`, not sent. For real delivery, comment the line below, uncomment
# the SMTP block, and fill it in. settings.py reads the SMTP vars only when
# EMAIL_BACKEND is the smtp backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- SMTP (uncomment the whole block; example filled for a HostArmada/cPanel
#     mailbox — for Google Workspace use smtp.gmail.com:587 + an App Password) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.YOURDOMAIN.tld        # cPanel > Email Accounts > Connect Devices shows it
# EMAIL_PORT=587                        # 587 = STARTTLS (below). 465 = SSL: flip the two flags.
# EMAIL_HOST_USER=no-reply@YOURDOMAIN.tld   # a real mailbox; must equal the From address
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL above must be that same mailbox, and YOURDOMAIN.tld needs
# SPF + DKIM pointing at the mail host or Gmail/Outlook will spam-file or reject.

# ── Google OAuth — "Continue with Google" on the login page (optional; blank
#    = button hidden, sign-in still works via magic link). Identity only
#    (openid/email/profile), not used for anything else.
#    Register an OAuth 2.0 "Web application" client in Google Cloud Console with:
#      Authorized redirect URI:  https://crm.founderslab.cloud/login
#      Authorized JS origin:     https://crm.founderslab.cloud
#    CLIENT_ID is read by both containers; SECRET only by the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_DOMAIN=https://crm.founderslab.cloud

# ── Operator console + per-tenant subdomain routing ───────────────────────
# Base domain every tenant is served under:
#   <org.subdomain>.<TENANT_BASE_DOMAIN>      the branded subdomain
#   <org.routing_key>.<TENANT_BASE_DOMAIN>    the stable CNAME target
# ALLOWED_HOSTS / CSRF / CORS above all derive from this.
TENANT_BASE_DOMAIN=crm.founderslab.cloud
# Enable per-tenant routing: the backend rewrites this file with one Traefik
# router per active subdomain (see docker-compose.prod.yml for the mount and
# the Traefik flags). Unset = routing off; assigning a subdomain in the
# operator console then does nothing until you wire it up.
# TRAEFIK_DYNAMIC_FILE=/dynamic/tenant-routes.yml
# The Traefik service the generated routers point at, plus the entrypoint and
# cert resolver. Defaults match this compose file; override only if yours differ.
# TENANT_ROUTER_SERVICE=crm-web@docker
# TENANT_ROUTER_ENTRYPOINTS=websecure
# TENANT_ROUTER_CERTRESOLVER=mytlschallenge
# Optional: authorises the /api/operator/ endpoints via the `X-Operator-Key`
# header for unattended automation (billing / cron). Empty = that path off;
# interactive superusers and superuser PATs still work. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OPERATOR_API_KEY=

# ── Frontend (SvelteKit / adapter-node) ────────────────────────────────────
# The Django origin the browser AND the SSR server call, no trailing /api.
PUBLIC_DJANGO_API_URL=https://api-crm.founderslab.cloud
# Do NOT set ORIGIN: with per-tenant subdomains the app is served from many
# hosts, and a fixed ORIGIN makes adapter-node 403 every form POST from a
# tenant subdomain ("Cross-site POST"). PROTOCOL_HEADER + HOST_HEADER let the
# server reconstruct the origin per request from Traefik's proxy headers. Safe
# only because Traefik is the sole ingress and overwrites those headers (the
# same trust assumption as TRUST_PROXY_SSL_HEADER on the Django side).
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
PORT=3000
